{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "MetaAgent Studio",
  "version": "0.1.0",
  "identifier": "com.metaagent.studio.app",
  "build": {
    "beforeDevCommand": "node_modules/.bin/vite",
    "beforeBuildCommand": "node_modules/.bin/vite build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MetaAgent Studio",
        "width": 1180,
        "height": 780,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
